{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/nestjs",
    "ultracite/biome/jest"
  ],
  "files": {
    "includes": [
      "!!**/dist",
      "!!**/node_modules",
      "!!**/generated",
      "!!**/*.graphql",
      "!!**/*.gql",
      "!!**/gql",
      "!!**/out",
      "!!**/*.svg"
    ]
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "globals": []
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useImportType": "off",
        "useBlockStatements": "off",
        "noParameterProperties": "off",
        "noEnum": "off",
        "noNonNullAssertion": "off"
      },
      "complexity": {
        "useSimplifiedLogicExpression": "off",
        "noExcessiveCognitiveComplexity": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "off"
      },
      "performance": {
        "useTopLevelRegex": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.spec.ts", "**/*.test.ts", "**/*.mock.ts"],
      "javascript": {
        "globals": [
          "jest",
          "describe",
          "it",
          "test",
          "expect",
          "beforeEach",
          "afterEach",
          "beforeAll",
          "afterAll"
        ]
      },
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "off"
          },
          "complexity": {
            "noUselessConstructor": "off"
          }
        }
      }
    }
  ]
}
