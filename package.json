{
  "name": "profile-info",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "setup": "bash setup.sh",
    "sync:cursor-rules": "bash scripts/sync-cursor-rules.sh",
    "postinstall": "npm run sync:cursor-rules",
    "prepare": "husky || true",
    "docker:up": "sudo docker compose up",
    "docker:down": "sudo docker compose down",
    "api:dev": "npm run dev --workspace=@profile-info/api",
    "api:build": "npm run build --workspace=@profile-info/api",
    "api:start": "npm run start --workspace=@profile-info/api",
    "api:seed": "npm run seed --workspace=@profile-info/api",
    "admin:dev": "npm run dev --workspace=@profile-info/admin",
    "admin:build": "npm run build --workspace=@profile-info/admin",
    "admin:start": "npm run start --workspace=@profile-info/admin",
    "dev": "concurrently -c \"blue,magenta\" -n \"api,admin\" \"npm run api:dev\" \"npm run admin:dev\"",
    "prod": "concurrently -c \"blue,magenta\" -n \"api,admin\" \"npm run api:prod\" \"npm run admin:prod\"",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspaces --if-present",
    "tree": "tree apps/ -I 'node_modules|dist|build|.git' -L 7 -F",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "test:cov": "npm run test:cov --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3",
    "ultracite": "^7.8.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "npx ultracite fix"
    ]
  }
}
