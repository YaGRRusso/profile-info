{
  "rootDir": "../../",
  "cacheDirectory": "<rootDir>/.cache/jest-e2e",
  "moduleFileExtensions": ["js", "json", "ts"],
  "testEnvironment": "node",
  "globalSetup": "<rootDir>/test/config/global-setup.ts",
  "setupFiles": ["<rootDir>/test/config/setup-env.ts"],
  "testTimeout": 120000,
  "maxWorkers": 1,
  "testMatch": [
    "<rootDir>/test/e2e/**/*.spec.ts",
    "<rootDir>/test/integration/**/*.spec.ts"
  ],
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1",
    "^@seed/(.*)$": "<rootDir>/seed/$1",
    "^@test/(.*)$": "<rootDir>/test/$1",
    "^@openrouter/sdk(.*)$": "<rootDir>/test/mocks/openrouter-sdk.mock.ts"
  },
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "tsconfig.test.json"
      }
    ]
  },
  "transformIgnorePatterns": ["node_modules/(?!(p-limit|yocto-queue)/)"],
  "globalTeardown": "<rootDir>/test/config/global-teardown.ts"
}
